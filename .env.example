# ─── Database ──────────────────────────────────────────────────────────────
# PostgreSQL connection string. On Vercel use your managed Postgres URL
# (Neon / Supabase / Vercel Postgres). Add ?sslmode=require if your host needs it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kumar_ayurveda?schema=public"

# ─── Site ──────────────────────────────────────────────────────────────────
# Public URL, no trailing slash. Used for canonical URLs, sitemap, emails.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Admin authentication ──────────────────────────────────────────────────
# Long random string (≥ 32 chars). Generate with:  openssl rand -base64 48
AUTH_SECRET=""

# ─── Email (Resend) ────────────────────────────────────────────────────────
# Leave RESEND_API_KEY empty in development: emails are printed to the console.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Kumar Ayurveda <appointments@yourdomain.com>"
# Where new-booking notifications go (comma-separate for several addresses).
ADMIN_NOTIFICATION_EMAIL="clinic@yourdomain.com"

# ─── First owner account (read only by `npm run db:seed`) ──────────────────
SEED_OWNER_EMAIL="owner@yourdomain.com"
SEED_OWNER_PASSWORD=""   # at least 10 characters
SEED_OWNER_NAME="Clinic Owner"
# Optional front-desk account with STAFF role
SEED_STAFF_EMAIL=""
SEED_STAFF_PASSWORD=""
SEED_STAFF_NAME="Front Desk"
